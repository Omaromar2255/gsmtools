<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <SolidColorBrush x:Key="BgDarkPrimary" Color="#0B0D13" />
    <SolidColorBrush x:Key="BgCardPrimary" Color="#131722" />
    <SolidColorBrush x:Key="BgCardSecondary" Color="#1B2030" />
    <SolidColorBrush x:Key="BgConsole" Color="#080A0F" />
    <SolidColorBrush x:Key="BorderSubtle" Color="#252C3E" />
    <SolidColorBrush x:Key="BorderFocus" Color="#00B0FF" />

    <SolidColorBrush x:Key="AccentCyan" Color="#00E5FF" />
    <SolidColorBrush x:Key="AccentBlue" Color="#0088FF" />
    <SolidColorBrush x:Key="AccentGreen" Color="#00E676" />
    <SolidColorBrush x:Key="AccentOrange" Color="#FF9100" />
    <SolidColorBrush x:Key="AccentRed" Color="#FF3D71" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8E9AA8" />
    <SolidColorBrush x:Key="TextMuted" Color="#5A6678" />

    <!-- Button Style -->
    <Style x:Key="ModernDarkButton" TargetType="Button">
        <Setter Property="Background" Value="#1A233A" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#00B0FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0077E6" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#00E5FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#0055B3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent Action Button -->
    <Style x:Key="AccentActionButton" TargetType="Button" BasedOn="{StaticResource ModernDarkButton}">
        <Setter Property="Background" Value="#0070E0" />
        <Setter Property="BorderBrush" Value="#00E5FF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Card Border -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCardPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

</ResourceDictionary>
